{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "surraviphharma.com"
        }
      ],
      "destination": "https://www.surraviphharma.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/catalogue/(.*)\\.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Surravi-Phharma-Product-Catalogue.pdf\"" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
