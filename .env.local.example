# ========== NEXT.JS / GENERAL ==========
# Set to 'production' on live server
NODE_ENV=development

# ========== ANALYTICS ==========
# Google Analytics 4 Measurement ID (optional, looks like G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# ========== SECURITY & RATE LIMITING ==========
# For production, use Upstash Redis or similar
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# ========== EMAILJS ENQUIRY EMAILS ==========
# Public EmailJS values used by the server API route to send admin/customer emails.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=wzq6fZXWHwFkqtlUw
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_0ywz7nh
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_czqsg3q
NEXT_PUBLIC_EMAILJS_AUTOREPLY_TEMPLATE_ID=template_wcsdwrm
EMAILJS_PRIVATE_KEY=your-emailjs-private-key-here

# Optional: where admin enquiry notifications should be sent.
EMAILJS_ADMIN_TO_EMAIL=surraviphharma@gmail.com

# ========== DOMAIN & CORS ==========
# Used for security headers validation
NEXT_PUBLIC_APP_URL=https://www.surraviphharma.com

# ========== OPTIONAL: EXTERNAL APIS ==========
# Add any third-party API keys here (not in source code!)
# Never commit .env.local to git

# ========== NOTES ==========
# 1. Never commit .env.local to version control
# 2. NEXT_PUBLIC_* variables are accessible in frontend (only safe public data)
# 3. Secret keys stay in .env.local (backend only)
# 4. On production: set variables in hosting platform (Vercel, Railway, etc.)
# 5. Rotate keys periodically
# 6. Use strong, unique secrets (min 32 characters)
